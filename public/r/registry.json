{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "frontend-ui",
  "homepage": "https://idelberto.github.io/DS.frontend-ui.REACT",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Tema",
      "description": "Cores do claro e do escuro do Admin One, a cor da marca (--brand) e seus derivados, e o raio. A fonte é a --font-sans que o projeto carrega.",
      "cssVars": {
        "theme": {
          "color-brand": "var(--brand)",
          "color-brand-foreground": "var(--brand-foreground)",
          "color-brand-muted": "var(--brand-muted)",
          "color-brand-muted-foreground": "var(--brand-muted-foreground)"
        },
        "light": {
          "brand": "oklch(0.546 0.245 262.881)",
          "brand-foreground": "oklch(1 0 0)",
          "brand-muted": "color-mix(in oklch, var(--brand) 8%, white)",
          "brand-muted-foreground": "var(--brand)",
          "background": "oklch(0.985 0.002 247.839)",
          "foreground": "oklch(0.21 0.034 264.665)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.21 0.034 264.665)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.21 0.034 264.665)",
          "primary": "var(--brand)",
          "primary-foreground": "var(--brand-foreground)",
          "secondary": "oklch(0.967 0.003 264.542)",
          "secondary-foreground": "oklch(0.21 0.034 264.665)",
          "muted": "oklch(0.967 0.003 264.542)",
          "muted-foreground": "oklch(0.551 0.027 264.364)",
          "accent": "oklch(0.967 0.003 264.542)",
          "accent-foreground": "oklch(0.21 0.034 264.665)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.967 0.003 264.542)",
          "input": "oklch(0.373 0.034 259.733)",
          "ring": "var(--brand)",
          "radius": "0.5rem",
          "sidebar": "oklch(0.985 0.002 247.839)",
          "sidebar-foreground": "oklch(0.373 0.034 259.733)",
          "sidebar-primary": "var(--brand)",
          "sidebar-primary-foreground": "var(--brand-foreground)",
          "sidebar-accent": "oklch(0.967 0.003 264.542)",
          "sidebar-accent-foreground": "oklch(0.21 0.034 264.665)",
          "sidebar-border": "oklch(0.928 0.006 264.531)",
          "sidebar-ring": "var(--brand)"
        },
        "dark": {
          "brand-muted": "color-mix(in oklch, var(--brand) 20%, transparent)",
          "brand-muted-foreground": "color-mix(in oklch, var(--brand) 60%, white)",
          "background": "oklch(0.279 0.041 260.031)",
          "foreground": "oklch(0.968 0.007 247.896)",
          "card": "oklch(0.229 0.042 264.04)",
          "card-foreground": "oklch(0.968 0.007 247.896)",
          "popover": "oklch(0.208 0.042 265.755)",
          "popover-foreground": "oklch(0.968 0.007 247.896)",
          "primary": "var(--brand)",
          "primary-foreground": "var(--brand-foreground)",
          "secondary": "oklch(0.208 0.042 265.755)",
          "secondary-foreground": "oklch(0.968 0.007 247.896)",
          "muted": "oklch(0.372 0.044 257.287)",
          "muted-foreground": "oklch(0.704 0.04 256.788)",
          "accent": "oklch(0.372 0.044 257.287)",
          "accent-foreground": "oklch(0.968 0.007 247.896)",
          "destructive": "oklch(0.637 0.237 25.331)",
          "border": "oklch(0.372 0.044 257.287)",
          "input": "oklch(0.373 0.034 259.733)",
          "ring": "var(--brand)",
          "sidebar": "oklch(0.208 0.042 265.755)",
          "sidebar-foreground": "oklch(0.869 0.022 252.894)",
          "sidebar-primary": "var(--brand)",
          "sidebar-primary-foreground": "var(--brand-foreground)",
          "sidebar-accent": "oklch(0.279 0.041 260.031)",
          "sidebar-accent-foreground": "oklch(1 0 0)",
          "sidebar-border": "oklch(0.279 0.041 260.031)",
          "sidebar-ring": "var(--brand)"
        }
      }
    },
    {
      "name": "app-shell",
      "type": "registry:block",
      "title": "App shell",
      "description": "Menu lateral do Admin One sobre o sidebar do shadcn (grupos, ícones, item ativo, item \"Em breve\", menu recolhido e sobreposição no celular) e a barra superior, com espaço para a marca, a unidade e o usuário.",
      "registryDependencies": ["sidebar", "@frontend-ui/theme"],
      "files": [
        {
          "path": "registry/frontend-ui/app-shell/components/app-shell.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/frontend-ui/app-shell/components/app-sidebar.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/frontend-ui/app-shell/components/app-navigation.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "section-main",
      "type": "registry:component",
      "title": "Section main",
      "description": "A área de conteúdo da página, com o espaçamento e a largura máxima do Admin One.",
      "files": [
        {
          "path": "registry/frontend-ui/section-main/components/section-main.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "section-title",
      "type": "registry:component",
      "title": "Section title",
      "description": "O título da página com o ícone redondo e a ação à direita.",
      "registryDependencies": ["@frontend-ui/theme"],
      "files": [
        {
          "path": "registry/frontend-ui/section-title/components/section-title.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "footer-bar",
      "type": "registry:component",
      "title": "Footer bar",
      "description": "O rodapé com o nome, o ano e a versão.",
      "registryDependencies": ["@frontend-ui/theme"],
      "files": [
        {
          "path": "registry/frontend-ui/footer-bar/components/footer-bar.tsx",
          "type": "registry:component"
        }
      ]
    }
